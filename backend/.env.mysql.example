# MySQL production profile. Copy these entries into backend/.env only after
# creating the MySQL account and completing the migration.
DB_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=wordagent
MYSQL_PASSWORD=change-this-password
MYSQL_AUTH_DATABASE=wordagent_auth
MYSQL_DATABASE_PREFIX=wordagent_company
MYSQL_CONNECT_TIMEOUT_SECONDS=10
MYSQL_READ_TIMEOUT_SECONDS=120
MYSQL_WRITE_TIMEOUT_SECONDS=120

# Keep the existing file/data settings. They still control local uploads,
# templates, generated Word files and other non-database assets.
WORDAGENT_BRIDGE_DATA_DIR=./data
WORDAGENT_BRIDGE_DATABASE_PATH=./data/wordagent.sqlite3
