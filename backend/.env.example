# 智能标书系统后端配置模板
# 复制为 .env 后填写真实值：Copy-Item .env.example .env

WORDAGENT_BRIDGE_HOST=127.0.0.1
WORDAGENT_BRIDGE_PORT=3896
WORDAGENT_BRIDGE_DATA_DIR=./data
# Tender upload limit in MiB (1 GiB by default).
BID_MAX_UPLOAD_SIZE_MB=1024
WORDAGENT_BRIDGE_DATABASE_PATH=./data/wordagent.sqlite3
# Optional MySQL production mode. See ../MYSQL_MIGRATION.md before enabling.
# DB_BACKEND=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=wordagent
# MYSQL_PASSWORD=change-this-password
# MYSQL_AUTH_DATABASE=wordagent_auth
# MYSQL_DATABASE_PREFIX=wordagent_company
WORDAGENT_BRIDGE_CORS_ORIGINS=["http://localhost:5181","http://127.0.0.1:5181"]

# 首次启动时创建系统管理员，至少 12 位；首次创建后，修改这里不会自动重置已有密码。
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
AUTH_SESSION_DAYS=7

# 大模型配置：生产/演示环境请填写真实 API Key
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_GENERATION_MODEL=qwen3.7-flash
QWEN_TIMEOUT_SECONDS=60
QWEN_DOCUMENT_ANALYSIS_TIMEOUT_SECONDS=180
QWEN_ENABLE_THINKING=False
ENABLE_LLM_PARSE_OPTIMIZE=True

# Qwen OCR 当前默认关闭；如需重新启用，再改为 True 并确认模型权限
QWEN_OCR_ENABLED=False
QWEN_OCR_MODEL=qwen3.5-ocr
QWEN_OCR_TIMEOUT_SECONDS=120
QWEN_OCR_MAX_ASSETS_PER_ITEM=1000

# 向量检索配置。
# VECTOR_BACKEND=local 使用原本 SQLite 本地兜底检索；改为 milvus 后启用 Milvus。
VECTOR_BACKEND=qdrant
VECTOR_EMBEDDING_PROVIDER=ollama
VECTOR_EMBEDDING_DIMENSION=1024
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMENSIONS=1024
QWEN_EMBEDDING_BATCH_SIZE=10
QWEN_EMBEDDING_TIMEOUT_SECONDS=60
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=
MILVUS_COLLECTION_KNOWLEDGE=new_biaoshuai_knowledge_chunks
MILVUS_COLLECTION_RAG_CASES=new_biaoshuai_rag_case_chunks
MILVUS_TIMEOUT_SECONDS=10
MILVUS_SEARCH_MULTIPLIER=30

# Qdrant 单机模式。安装 qdrant-client 后，将 VECTOR_BACKEND 改为 qdrant。
QDRANT_URL=
QDRANT_PATH=./data/qdrant
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=10
QDRANT_COLLECTION_KNOWLEDGE=wordagent_knowledge_chunks_bge_m3_v1
QDRANT_COLLECTION_RAG_CASES=wordagent_rag_case_chunks_bge_m3_v1
# 本地 Ollama Embedding（不调用云端 API）。中文知识库可使用 bge-m3。
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_DIMENSIONS=1024
OLLAMA_EMBEDDING_BATCH_SIZE=8
OLLAMA_TIMEOUT_SECONDS=180
# 混合检索与后台向量索引参数：
# RAG_SEARCH_OVERFETCH=10
# RAG_RRF_CONSTANT=60
# RAG_VECTOR_TASK_LEASE_SECONDS=21600
# RAG_VECTOR_TASK_MAX_ATTEMPTS=3
# RAG_VECTOR_TASK_RETRY_BASE_SECONDS=2

# 图片生成能力，可按需开启/替换模型
QWEN_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
QWEN_IMAGE_MODEL=qwen-image-3.0
QWEN_IMAGE_TIMEOUT_SECONDS=90

# 本地 Mermaid dist 目录。留空时后端会自动探测：
# 1) new_biaoshuai/mermaid-develop/packages/mermaid/dist
# 2) 与 new_biaoshuai 同级的 mermaid-develop/packages/mermaid/dist
MERMAID_DIST_DIR=

# 可选 DOCX 后处理。没有安装 officecli 时会自动降级为 python-docx 导出。
ENABLE_OFFICECLI_DOCX_FORMATTING=True
OFFICECLI_BINARY=officecli
OFFICECLI_TIMEOUT_SECONDS=20

# 高德地图 Web 服务 Key，仅保存在后端环境变量中
AMAP_WEB_SERVICE_KEY=

# DeepSeek 文本模型（独立 API Key）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
